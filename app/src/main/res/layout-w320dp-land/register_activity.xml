<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bluebackground">

    <TextView
        android:id="@+id/labelInicio"
        android:layout_width="252dp"
        android:layout_height="80dp"
        android:autoSizeMaxTextSize="200dp"
        android:autoSizeMinTextSize="12dp"
        android:autoSizeTextType="uniform"
        android:text="@string/inicio"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/guideline6"
        app:layout_constraintEnd_toStartOf="@+id/paredInferior"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/paredSuperior"
        app:layout_constraintTop_toTopOf="@+id/paredDerecha"
        app:layout_constraintVertical_bias="1.0" />

    <Button
        android:id="@+id/buttonRondas10"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginTop="12dp"
        android:autoSizeMaxTextSize="200dp"
        android:autoSizeMinTextSize="12dp"
        android:autoSizeTextType="uniform"
        android:background="@drawable/edit_text_radius"
        android:gravity="center"
        android:text="10"
        android:textColor="@color/black"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toStartOf="@+id/guideline8"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline7"
        app:layout_constraintTop_toBottomOf="@+id/buttonRondas5" />

    <Button
        android:id="@+id/buttonRegisterAceptar"
        android:layout_width="145dp"
        android:layout_height="46dp"
        android:background="@drawable/boton_verde"
        android:text="@string/aceptar"
        android:textColor="@color/white"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@+id/paredIzquierda"
        app:layout_constraintEnd_toStartOf="@+id/guideline12"
        app:layout_constraintStart_toStartOf="@+id/guideline8" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/paredDerecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/paredSuperior"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="710dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/paredIzquierda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.94" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/paredInferior"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.955" />

    <Button
        android:id="@+id/buttonNivel2"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginBottom="12dp"
        android:autoSizeMaxTextSize="200dp"
        android:autoSizeMinTextSize="12dp"
        android:autoSizeTextType="uniform"
        android:background="@drawable/edit_text_radius"
        android:gravity="center"
        android:text="@string/nivel_2"
        android:textColor="@color/black"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@+id/buttonNivel3"
        app:layout_constraintEnd_toStartOf="@+id/guideline13"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/guideline12" />

    <Button
        android:id="@+id/buttonNivel1"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginBottom="12dp"
        android:autoSizeMaxTextSize="200dp"
        android:autoSizeMinTextSize="12dp"
        android:autoSizeTextType="uniform"
        android:background="@drawable/edit_text_radius"
        android:gravity="center"
        android:text="@string/nivel_1"
        android:textColor="@color/black"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@+id/buttonNivel2"
        app:layout_constraintEnd_toStartOf="@+id/guideline13"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline12"
        app:layout_constraintTop_toBottomOf="@+id/labelNivel"
        app:layout_constraintVertical_bias="0.909" />

    <Button
        android:id="@+id/buttonNivel3"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:autoSizeMaxTextSize="200dp"
        android:autoSizeMinTextSize="12dp"
        android:autoSizeTextType="uniform"
        android:background="@drawable/edit_text_radius"
        android:gravity="center"
        android:text="@string/nivel_3"
        android:textColor="@color/black"
        app:backgroundTint="@null"
        app:layout_constraintDimensionRatio="1:0"
        app:layout_constraintEnd_toStartOf="@+id/guideline13"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline12"
        tools:layout_editor_absoluteY="290dp" />

    <Button
        android:id="@+id/buttonRondas15"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginTop="12dp"
        android:autoSizeMaxTextSize="200dp"
        android:autoSizeMinTextSize="12dp"
        android:autoSizeTextType="uniform"
        android:background="@drawable/edit_text_radius"
        android:gravity="center"
        android:text="15"
        android:textColor="@color/black"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toStartOf="@+id/guideline8"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/guideline7"
        app:layout_constraintTop_toBottomOf="@+id/buttonRondas10" />

    <Button
        android:id="@+id/buttonRondas5"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginTop="20dp"
        android:autoSizeMaxTextSize="200dp"
        android:autoSizeMinTextSize="12dp"
        android:autoSizeTextType="uniform"
        android:background="@drawable/edit_text_radius"
        android:gravity="center"
        android:text="5"
        android:textColor="@color/black"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toStartOf="@+id/guideline8"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/guideline7"
        app:layout_constraintTop_toBottomOf="@+id/labelRondas" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.62" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline13"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.9" />

    <TextView
        android:id="@+id/labelNivel"
        android:layout_width="184dp"
        android:layout_height="35dp"
        android:layout_marginTop="12dp"
        android:autoSizeMaxTextSize="200dp"
        android:autoSizeMinTextSize="12dp"
        android:autoSizeTextType="uniform"
        android:text="@string/dificultad"
        android:textAlignment="center"
        android:textColor="@color/white"
        app:layout_constraintEnd_toStartOf="@+id/guideline13"
        app:layout_constraintHorizontal_bias="0.571"
        app:layout_constraintStart_toStartOf="@+id/guideline12"
        app:layout_constraintTop_toTopOf="@+id/guideline6" />

    <TextView
        android:id="@+id/labelRondas"
        android:layout_width="143dp"
        android:layout_height="35dp"
        android:layout_marginTop="12dp"
        android:autoSizeMaxTextSize="200dp"
        android:autoSizeMinTextSize="12dp"
        android:autoSizeTextType="uniform"
        android:text="@string/rondas"
        android:textAlignment="center"
        android:textColor="@color/white"
        app:layout_constraintEnd_toStartOf="@+id/guideline8"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/guideline7"
        app:layout_constraintTop_toTopOf="@+id/guideline6" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.26" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.1" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.38" />
</androidx.constraintlayout.widget.ConstraintLayout>