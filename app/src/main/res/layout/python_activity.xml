<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:padding="24dp"
    android:background="@drawable/bluebackground"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="24dp"
            >

            <!-- Título grande para tablet -->

            <ImageButton
                android:id="@+id/IconBack"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="start"
                android:background="@null"
                android:scaleType="fitStart"
                android:src="@drawable/flecha_izquierda" />
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analytics Python Engine"
                android:background="@drawable/edit_text_radius"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:padding="15dp"
                android:gravity="center"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/labelNumRonda"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:text=""
                android:textSize="60dp"
                android:gravity="center"
                />

        </LinearLayout>
        <!-- Botón para ejecutar el script -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnRunPython"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Ejecutar Análisis Python"
                android:textSize="20sp"
                android:background="@drawable/boton_verde"
                app:backgroundTint="@null"
                app:layout_constraintWidth_percent="0.6"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Texto para mostrar logs del script -->
        <TextView
            android:id="@+id/tvOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EEEEEE"
            android:padding="16dp"
            android:scrollbars="vertical"
            android:text="Salida del script aparecerá aquí..."
            android:textSize="16sp" />

        <!-- Imagen 1: Histograma -->
        <ImageView
            android:id="@+id/imgHistograma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_marginTop="24dp"/>

        <!-- Imagen 2: Scatter -->
        <ImageView
            android:id="@+id/imgScatter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_marginTop="24dp"/>

        <!-- Imagen 3: Barras por dificultad -->
        <ImageView
            android:id="@+id/imgPuntuacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_marginTop="24dp"/>

        <ImageView
            android:id="@+id/imgHeatmapRetorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/imgBoxRecurrentes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/imgAciertosErroresRetorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />
    </LinearLayout>

</ScrollView>
