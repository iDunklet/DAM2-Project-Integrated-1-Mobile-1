<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:padding="24dp"
    android:background="@drawable/bluebackground"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Título grande para tablet -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Analytics Python Engine"
            android:background="@drawable/edit_text_radius"
            android:textSize="32sp"
            android:textStyle="bold"
            android:paddingBottom="24dp"
            android:textAlignment="center"/>

        <!-- Botón para ejecutar el script -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnRunPython"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Ejecutar Análisis Python"
                android:textSize="20sp"
                android:background="@drawable/boton_verde"
                app:backgroundTint="@null"
                app:layout_constraintWidth_percent="0.6"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Texto para mostrar logs del script -->
        <TextView
            android:id="@+id/tvOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EEEEEE"
            android:padding="16dp"
            android:scrollbars="vertical"
            android:text="Salida del script aparecerá aquí..."
            android:textSize="16sp" />

        <!-- Imagen 1: Histograma -->
        <ImageView
            android:id="@+id/imgHistograma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_marginTop="24dp"/>

        <!-- Imagen 2: Scatter -->
        <ImageView
            android:id="@+id/imgScatter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_marginTop="24dp"/>

        <!-- Imagen 3: Barras por dificultad -->
        <ImageView
            android:id="@+id/imgPuntuacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_marginTop="24dp"/>

        <ImageView
            android:id="@+id/imgHeatmapRetorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/imgBoxRecurrentes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/imgAciertosErroresRetorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />
    </LinearLayout>

</ScrollView>
